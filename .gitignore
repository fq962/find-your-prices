# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# claude
# .claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Material de referencia del scraping (paginas guardadas para analizar).
# Ademas de no pertenecer al repo, dejarlo fuera evita que la deteccion
# automatica de fuentes de Tailwind escanee ese html y genere utilidades basura.
/to-scrap/

# Impeccable
# Ajustes locales de Impeccable (consentimientos, preferencias de sesion).
# El resto de .impeccable/ SI va al repo: es contexto compartido del proyecto.
/.impeccable/config.local.json
/.impeccable/live/inject-journal.json
