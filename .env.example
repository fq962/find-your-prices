# Copia este archivo a .env.local y rellena los valores reales.
# .env* ya esta en .gitignore, asi que nunca se sube al repo.

# -----------------------------------------------------------------------------
# SEO
# -----------------------------------------------------------------------------
# Origen publico del sitio. De aqui salen las canonicas, los hreflang, el Open
# Graph, robots.txt y los sitemaps.
#
# IMPORTANTE en produccion: si esto se queda con una URL de preview de Vercel
# (*.vercel.app), TODAS las canonicas apuntan ahi y Google indexa el dominio
# equivocado. En el entorno de produccion tiene que decir https://findyourprices.com
# Si la variable no esta definida, el codigo cae a ese dominio por su cuenta.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Codigos de verificacion de las consolas de busqueda. Opcionales: sin valor
# simplemente no se emite la etiqueta.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=

# -----------------------------------------------------------------------------
# Base de datos: Supabase (Postgres). Todo vive en el esquema find_your_prices.
# Recorda exponerlo en Supabase -> Settings -> API -> Exposed schemas.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Llave publica (navegador). Solo lee el catalogo, sujeta a RLS.
SUPABASE_PUBLISHABLE_KEY=
# Llave de servidor. Ignora RLS: NUNCA la expongas al cliente.
SUPABASE_SECRET_KEY=

# Equivalentes en el formato clasico de Supabase; sirven como alternativa.
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_SECRET=

# -----------------------------------------------------------------------------
# Scraping
# -----------------------------------------------------------------------------
# Obligatorio: protege /api/scraping/run. Sin este valor el endpoint responde 401.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Opcional: protege el CRUD del panel (/api/scraping/targets, /stores, /runs).
# Vacio = panel abierto, tal como esta previsto hasta que entre OAuth.
# ADMIN_API_SECRET=
