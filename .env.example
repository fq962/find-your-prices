# Copia este archivo a .env.local y rellena los valores reales.
# .env* ya esta en .gitignore, asi que nunca se sube al repo.

# -----------------------------------------------------------------------------
# SEO
# -----------------------------------------------------------------------------
# Origen publico del sitio. De aqui salen las canonicas, los hreflang, el Open
# Graph, robots.txt y los sitemaps.
#
# IMPORTANTE en produccion: si esto se queda con una URL de preview de Vercel
# (*.vercel.app), TODAS las canonicas apuntan ahi y Google indexa el dominio
# equivocado. En el entorno de produccion tiene que decir https://findyourprices.com
# Si la variable no esta definida, el codigo cae a ese dominio por su cuenta.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Codigos de verificacion de las consolas de busqueda. Opcionales: sin valor
# simplemente no se emite la etiqueta.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=

# -----------------------------------------------------------------------------
# Base de datos: conexión directa a Postgres (Drizzle). docs/migracion-drizzle.md
# -----------------------------------------------------------------------------
# La usan `next dev`, los scripts, GitHub Actions y `npm run db:pull`. En el
# Worker de producción la conexión sale del binding HYPERDRIVE, no de acá.
# Mientras sigamos en Supabase: Settings -> Database -> Connection string,
# modo "Session pooler" (puerto 5432). El modo "Transaction" (6543) también
# sirve: el cliente apaga las sentencias preparadas solo.
# NO uses la conexión directa (db.<ref>.supabase.co): es solo IPv6 y desde
# Vercel/GitHub Actions da "getaddrinfo ENOTFOUND". En Vercel usá el
# "Transaction pooler" (6543): el modo sesión (5432) corta en 15 clientes para
# todo el proyecto y el build/las funciones lo agotan (EMAXCONNSESSION).
# Opcional: conexiones por proceso (por defecto en Vercel/CI: 5 en modo
# transacción, 3 en modo sesión; 10 local).
# DATABASE_POOL_MAX=
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# -----------------------------------------------------------------------------
# Archivos: Cloudflare R2 (imágenes del panel y sitemaps). server/storage/r2.ts
# -----------------------------------------------------------------------------
# Panel de Cloudflare -> R2 -> Manage API tokens: un token con "Object Read &
# Write" sobre el bucket. El Account ID sale en la misma página.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=find-your-prices
# Origen público del bucket, sin barra final. Para producción, un dominio
# propio (R2 -> bucket -> Settings -> Custom Domains), p. ej.
# https://assets.findyourprices.com. El r2.dev sirve para probar, pero
# Cloudflare lo limita y no lo recomienda para tráfico real.
R2_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Base de datos: Supabase (Postgres). Todo vive en el esquema find_your_prices.
# (Se va cuando termine la migración a Drizzle.)
# Recorda exponerlo en Supabase -> Settings -> API -> Exposed schemas.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Llave publica (navegador). Solo lee el catalogo, sujeta a RLS.
SUPABASE_PUBLISHABLE_KEY=
# Llave de servidor. Ignora RLS: NUNCA la expongas al cliente.
SUPABASE_SECRET_KEY=

# Equivalentes en el formato clasico de Supabase; sirven como alternativa.
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_SECRET=

# -----------------------------------------------------------------------------
# Scraping
# -----------------------------------------------------------------------------
# Obligatorio: protege /api/scraping/run. Sin este valor el endpoint responde 401.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Opcional: protege el CRUD del panel (/api/scraping/targets, /stores, /runs).
# Vacio = panel abierto, tal como esta previsto hasta que entre OAuth.
# ADMIN_API_SECRET=

# -----------------------------------------------------------------------------
# Estadísticas de visitas
# -----------------------------------------------------------------------------
# Opcional: secreto para el hash anónimo de visitantes (la IP nunca se guarda).
# Sin valor se deriva de CRON_SECRET. Cambiarlo a mitad de mes reinicia el
# conteo de visitantes únicos de ese mes.
# ANALYTICS_SALT=
# En desarrollo no se registran visitas (la base es la de producción y se
# inflarían las cifras). Poné 1 solo para probar el recolector.
# ANALYTICS_IN_DEV=

# -----------------------------------------------------------------------------
# Bitácora de errores
# -----------------------------------------------------------------------------
# En desarrollo los errores solo salen por consola (la base es la de
# producción). Poné 1 para probar que lleguen a /admin/errores.
# ERRORS_IN_DEV=
