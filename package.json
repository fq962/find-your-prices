{
  "name": "find-your-prices",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "scrape:local": "npx --yes tsx@4 --conditions=react-server --env-file=.env.local scripts/scrape-all-local.ts",
    "eneba:import": "npx --yes tsx@4 --conditions=react-server --env-file-if-exists=.env.local scripts/import-eneba.ts",
    "reingest:local": "npx --yes tsx@4 --conditions=react-server --env-file=.env.local scripts/reingest-local.ts",
    "sitemaps:generate": "npx --yes tsx@4 --conditions=react-server --tsconfig scripts/tsconfig.json --env-file-if-exists=.env.local scripts/generate-sitemaps.ts",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "prebuild": "node scripts/db-check.mjs",
    "storage:migrate": "npx --yes tsx@4 --conditions=react-server --tsconfig scripts/tsconfig.json --env-file=.env.local scripts/migrate-storage-to-r2.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "wrangler": "4.141.0"
  }
}
